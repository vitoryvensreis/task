{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskEsc API",
    "version": "1.1.0",
    "description": "API REST autenticada do TaskEsc para automações, integrações e futura camada MCP/ChatGPT. Valores monetários usam centavos e datas de escrita aceitam ISO 8601."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "TaskEsc API token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TaskWrite": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "integer"
          },
          "category_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ]
          },
          "assigned_to": {
            "type": [
              "integer",
              "null"
            ]
          },
          "billing_mode": {
            "type": "string",
            "enum": [
              "included",
              "one_off"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "client_id",
          "category_id",
          "title",
          "brief",
          "due_at"
        ]
      },
      "ClientWrite": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "commercial_type": {
            "type": "string",
            "enum": [
              "one_off",
              "monthly"
            ]
          },
          "monthly_amount_cents": {
            "type": "integer",
            "minimum": 0
          },
          "monthly_payment_day": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 31
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "drive_account_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "ID de uma conta Google conectada como Drive. Null/0 usa o Drive padrão do TaskEsc."
          }
        },
        "required": [
          "name"
        ]
      },
      "EventWrite": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "demand_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "all_day": {
            "type": "boolean"
          }
        },
        "required": [
          "calendar_id",
          "title",
          "starts_at",
          "ends_at"
        ]
      }
    }
  },
  "paths": {
    "/status": {
      "get": {
        "summary": "Status da API",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão"
          }
        }
      }
    },
