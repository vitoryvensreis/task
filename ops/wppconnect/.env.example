# Copie para .env no servidor. NUNCA comite o .env real.
WPP_SERVER_TAG=2.10.27
PORT=21465
HOST=https://wppconnect.escotilhaprodutora.com

# Gere com: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_64_HEX_SECRET

# Em produção, preencha com o endpoint assinado gerado por WppConnect::webhookUrl().
# O painel também informa esse webhook em start-session, mas manter aqui garante
# eventos após restart automático do container.
WEBHOOK_URL=

TOKEN_STORE_TYPE=file
CUSTOM_USER_DATA_DIR=/usr/src/wpp-server/userDataDir/
MAX_LISTENERS=30
MANAGER_ENABLED=false

