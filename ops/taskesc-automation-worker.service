[Unit]
Description=TaskEsc Automation Worker
After=network-online.target taskesc-realtime-worker.service
Wants=network-online.target

[Service]
Type=simple
User=@TASKESC_USER@
Group=@TASKESC_GROUP@
WorkingDirectory=@DEPLOY_PATH@
ExecStart=@PHP_BIN@ @DEPLOY_PATH@/bin/automation-worker.php
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@DEPLOY_PATH@/storage

[Install]
WantedBy=multi-user.target
